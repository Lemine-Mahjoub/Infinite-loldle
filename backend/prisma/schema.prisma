generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// prisma/schema.prisma
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  score     Int      @default(0)
  champ     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

